# GitHub Personal Access Token (read-only repo scope)
GITHUB_TOKEN=ghp_...

# Repository details
GITHUB_OWNER=jkolsun
GITHUB_REPO=bright_engine
GITHUB_BRANCH=main

# MCP server auth key — REQUIRED (fail closed: every MCP route answers 503 without it).
# At least 32 characters; generate with: openssl rand -hex 32
# claude.ai connector URL: https://<domain>/k/<MCP_API_KEY>/mcp  (or send Authorization: Bearer <key>)
MCP_API_KEY=generate-random-64-char-string

# Port (Railway assigns automatically)
PORT=3000